{
  "name": "nepali-tithi",
  "version": "0.1.0",
  "description": "Nepali tithi (lunar day) for a date and place, a birth tithi with or without birth time, and the date a tithi falls on each year. Matches Nepali patros (Surya Siddhanta, Nepal panchang committee method).",
  "keywords": [
    "tithi",
    "panchang",
    "panchanga",
    "nepali",
    "nepal",
    "patro",
    "hindu calendar",
    "lunar calendar",
    "surya siddhanta",
    "birthday"
  ],
  "license": "MIT",
  "author": "Sandesh Pathak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandesPathak/nepali-tithi.git"
  },
  "homepage": "https://github.com/sandesPathak/nepali-tithi#readme",
  "bugs": {
    "url": "https://github.com/sandesPathak/nepali-tithi/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:nepal": "tsx scripts/validate-nepal.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
